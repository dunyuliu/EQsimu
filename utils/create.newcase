#! /usr/bin/env python3
"""
create.newcase MODE CASE COMPSET --machine MACHINE

Convert the EQsimu compset COMPSET (compset/COMPSET/user_defined_params.py)
into each code's user_defined_params.py, then stage the case with the code's
own create.newcase. MACHINE (ls6, local, ...; see utils/machines.py) picks
the HPC_ncpu/nnode/queue/time/account (and, for EQdyna, the nx/ny/nz process
grid) the case launches with -- a problem never hardcodes these.

  qdc  quasi-dynamic cycle, EQquasi        CASE is an EQquasi case
  dr   dynamic rupture, EQdyna             CASE is an EQdyna case
  fdc  fully dynamic cycle, EQquasi+EQdyna CASE holds eqquasi/ and eqdyna/

For a code's own compsets, use that code's create.newcase directly.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

import convert
import machines

CODES = {"qdc": ["eqquasi"], "dr": ["eqdyna"], "fdc": ["eqquasi", "eqdyna"]}
# fdc case root: the problem, loaded from its copy in eqsimu/compset/ (so a
# derived compset still finds its base), for case.setup's istart/iend.
CASE_PARAMS = '''"""The problem of this case: eqsimu/compset/{compset}/. Set the cycles
case.setup chains here, e.g. par.istart, par.iend = 1, 3."""
import importlib.util
import os

_f = os.path.join(os.path.dirname(os.path.abspath(__file__)), "eqsimu",
                  "compset", "{compset}", "user_defined_params.py")
_spec = importlib.util.spec_from_file_location("eqsimu_case_problem", _f)
_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_mod)
par = _mod.par
'''
UTILS = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(UTILS)


def stage(code, compset_dir, case_dir, gen_dir, machine):
    """Generate code's compset in gen_dir and stage case_dir from it."""
    convert.write_code_compset(compset_dir, code, gen_dir, machine)
    tool = os.path.join(os.environ[convert.ROOT_ENV[code]], "scripts",
                        "create.newcase")
    subprocess.run([sys.executable, tool, case_dir,
                    convert.upstream_compset_arg(code, gen_dir)], check=True)


def compset_dirs(compset_dir):
    """compset_dir and every sibling compset it names (a derived compset
    loads its base, and the base's files, through ../<base>/)."""
    root = os.path.dirname(compset_dir)
    found, todo = [], [os.path.basename(compset_dir)]
    while todo:
        name = todo.pop()
        if name in found:
            continue
        found.append(name)
        with open(os.path.join(root, name, "user_defined_params.py")) as f:
            text = f.read()
        todo += [d for d in os.listdir(root) if d not in found and
                 os.path.isfile(os.path.join(root, d, "user_defined_params.py"))
                 and re.search(r"\b%s\b" % re.escape(d), text)]
    return [os.path.join(root, n) for n in found]


def record(case_dir, compset_dir, gen):
    """case/eqsimu/: the problem (compset/<name>/, with any base compsets it
    loads beside it), the generated files, the component commits."""
    dst = os.path.join(case_dir, "eqsimu")
    for d in compset_dirs(compset_dir):
        shutil.copytree(d, os.path.join(dst, "compset", os.path.basename(d)),
                        ignore=shutil.ignore_patterns("__pycache__"))
    for code, d in gen.items():
        shutil.copytree(d, os.path.join(dst, code))
    with open(os.path.join(dst, "components.txt"), "w") as f:
        for name, var in [("eqsimu", "EQSIMUROOT")] + \
                [(c, convert.ROOT_ENV[c]) for c in gen]:
            sha = subprocess.run(["git", "-C", os.environ[var], "rev-parse",
                                  "HEAD"], capture_output=True, text=True,
                                 check=True).stdout.strip()
            f.write(f"{name} {sha}\n")


def main():
    args = sys.argv[1:]
    machine = None
    if "--machine" in args:
        i = args.index("--machine")
        del args[i]
        try:
            machine = args.pop(i)
        except IndexError:
            sys.exit(__doc__)
    if len(args) != 3 or args[0] not in CODES or machine is None:
        sys.exit(__doc__)
    machines.machine(machine)  # raise now, naming the known machines, if unknown
    mode, case_dir, compset = args
    compset_dir = os.path.join(ROOT, "compset", compset)
    if not os.path.isdir(compset_dir):
        sys.exit(f"create.newcase: no EQsimu compset {compset} in "
                 f"{os.path.join(ROOT, 'compset')}")
    if os.path.exists(case_dir):
        sys.exit(f"create.newcase: {case_dir} exists; remove it first")
    case_dir = os.path.abspath(case_dir)

    with tempfile.TemporaryDirectory() as tmp:
        gen = {c: os.path.join(tmp, c) for c in CODES[mode]}
        if mode == "fdc":
            os.makedirs(case_dir)
            for code in gen:
                stage(code, compset_dir, os.path.join(case_dir, code),
                      gen[code], machine)
            for f in ["case.setup", "case.submit", "problemDefaults.py",
                     "machines.py"]:
                shutil.copy(os.path.join(UTILS, f), case_dir)
            with open(os.path.join(case_dir, "user_defined_params.py"),
                      "w") as f:
                f.write(CASE_PARAMS.format(compset=compset))
            # case.setup (EQsimu's own fdc orchestrator) reads this to decide
            # whether to sbatch each cycle or run it directly with bash.
            with open(os.path.join(case_dir, "machine.txt"), "w") as f:
                f.write(machine + "\n")
        else:
            (code,) = gen
            stage(code, compset_dir, case_dir, gen[code], machine)
        record(case_dir, compset_dir, gen)
    print(f"{mode} case {case_dir} from compset {compset}, machine {machine}")


if __name__ == "__main__":
    try:
        main()
    except convert.ConvertError as e:
        sys.exit(f"create.newcase: {e}")
