#! /usr/bin/env python3
"""
Set up a fully dynamic cycle (fdc) case and write exe.sh, the chain of
dependent jobs that case.submit runs: per cycle, one EQquasi job, then one
EQdyna job.

Each job runs its code's own run.sh. EQsimu passes only the restart files:
  cycle k EQdyna  reads eqquasi/result/cycle<k-1>/fault.r.nc (end of interseismic)
  cycle k EQquasi reads eqdyna/result/cycle<k-2>/fault.dyna.r.nc (end of rupture)
EQquasi keeps its outputs in eqquasi/result/cycle<k-1>/; each EQdyna cycle
runs in eqdyna/result/cycle<k-1>/, a copy of the eqdyna/ case files.

The case was created for one machine (create.newcase's --machine, recorded in
machine.txt). A scheduler machine (utils/machines.py: scheduler="slurm")
sbatches each cycle's batch.<code>.hpc, chained with --dependency=afterok. A
machine with no scheduler (scheduler=None, e.g. "local") instead runs each
batch.<code>.hpc directly with bash, in order, under this script's own
set -e -- no sbatch anywhere.
"""
import re
import subprocess
import sys

sys.dont_write_bytecode = True
from user_defined_params import par
from machines import machine


def read_machine():
    with open("machine.txt") as f:
        return f.read().strip()


def prepare(code):
    subprocess.run([sys.executable, "case.setup"], cwd=code, check=True)


def header(code):
    """The scheduler header and environment lines of code's own batch.hpc."""
    keep = ("#", "module ", "export ")
    with open(f"{code}/batch.hpc") as f:
        return [l.rstrip("\n") for l in f if l.lstrip().startswith(keep)]


def replace_once(text, pattern, new, where):
    text, n = re.subn(pattern, lambda m: new, text)
    if n != 1:
        raise SystemExit(f"case.setup: expected one '{pattern}' in {where}; "
                         f"EQquasi's run.sh changed, update utils/case.setup")
    return text


def eqquasi_run_cycle():
    """eqquasi/run.cycle.sh: EQquasi's run.sh for the one cycle $CYCLE,
    restarting from $RESTART_DIR instead of its own previous cycle."""
    with open("eqquasi/run.sh") as f:
        text = f.read()
    text = replace_once(text, r"for i in \$\(seq \d+ \d+\);",
                        "for i in ${CYCLE:?};", "eqquasi/run.sh")
    text = replace_once(text, re.escape('prev="result/cycle$((i-2))"'),
                        'prev="${RESTART_DIR:?}"', "eqquasi/run.sh")
    with open("eqquasi/run.cycle.sh", "w") as f:
        f.write(text)


EQQUASI_BODY = """\
set -e
k=$((CYCLE-1))
rm -rf eqquasi/restart && mkdir eqquasi/restart
if [ "$CYCLE" -gt 1 ]; then
  cp "eqdyna/result/cycle$((k-1))/fault.dyna.r.nc" eqquasi/restart/fault.r.nc
fi
cd eqquasi && CYCLE=$CYCLE RESTART_DIR=restart bash run.cycle.sh
test -e "result/cycle$k/fault.r.nc"
"""

EQDYNA_BODY = """\
set -e
k=$((CYCLE-1))
d="eqdyna/result/cycle$k"
rm -rf "$d" && mkdir -p "$d"
find eqdyna -maxdepth 1 -type f -exec cp {} "$d"/ \\;
cp "eqquasi/result/cycle$k/fault.r.nc" "$d"/
cd "$d" && bash run.sh
test -e fault.dyna.r.nc
"""


def write_batch(code, body):
    with open(f"batch.{code}.hpc", "w") as f:
        f.write("\n".join(header(code)) + "\n" + body)


def create_exe_shell(scheduler):
    with open("exe.sh", "w") as f:
        f.write("set -e\n")
        for cycle in range(par.istart, par.iend + 1):
            if scheduler == "slurm":
                dep = "" if cycle == par.istart else "--dependency=afterok:$jd "
                f.write(f"jq=$(sbatch --parsable {dep}--export=ALL,CYCLE={cycle} "
                        f"batch.eqquasi.hpc)\n")
                f.write(f"jd=$(sbatch --parsable --dependency=afterok:$jq "
                        f"--export=ALL,CYCLE={cycle} batch.eqdyna.hpc)\n")
                f.write(f'echo "cycle {cycle}: EQquasi $jq, EQdyna $jd"\n')
            else:
                # No scheduler (utils/machines.py: scheduler=None): no job to
                # queue, so run each cycle's body directly -- this script's
                # own `set -e` (not sbatch's --dependency=afterok) is what
                # stops the chain on a failed cycle.
                f.write(f"CYCLE={cycle} bash batch.eqquasi.hpc\n")
                f.write(f"CYCLE={cycle} bash batch.eqdyna.hpc\n")
                f.write(f'echo "cycle {cycle}: EQquasi, EQdyna (direct, no scheduler)"\n')


if __name__ == "__main__":
    prepare("eqdyna")
    prepare("eqquasi")
    eqquasi_run_cycle()
    write_batch("eqquasi", EQQUASI_BODY)
    write_batch("eqdyna", EQDYNA_BODY)
    create_exe_shell(machine(read_machine())["scheduler"])
